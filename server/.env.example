# Kopiere diese Datei zu ".env" und trage deinen Riot API Key ein.
# Key holen unter: https://developer.riotgames.com (Personal Key, läuft nach 24h ab)
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Region deines Accounts (Plattform-Endpoint für Summoner-Daten)
# Beispiele: euw1, na1, eun1, kr, jp1
RIOT_PLATFORM=euw1

# Regionaler Endpoint für Account/Match-API (passend zur Plattform)
# euw1/eun1/tr1/ru -> europe | na1/br1/la1/la2/oc1 -> americas | kr/jp1 -> asia
RIOT_REGION=europe

PORT=3000
