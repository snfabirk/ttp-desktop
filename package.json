{
  "name": "three-trick-pony-desktop",
  "version": "4.13.0",
  "private": true,
  "description": "Desktop-App fuer die Three-Trick-Pony OTP-Uebersicht (Electron-Wrapper um den lokalen Server)",
  "author": "Fabian",
  "main": "electron-main.js",
  "scripts": {
    "start": "electron .",
    "dist": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder",
    "release": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --publish always"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "electron-updater": "^6.8.9",
    "electron-window-state": "^5.0.3",
    "express": "^4.19.2"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^32.0.0",
    "electron-builder": "^25.1.8",
    "rcedit": "^5.0.2"
  },
  "build": {
    "appId": "com.fabian.threetrickpony",
    "productName": "Three-Trick-Pony",
    "asar": false,
    "files": [
      "electron-main.js",
      "package.json",
      "build/icon.ico",
      "build/icon.png",
      "build/update-preload.js",
      "build/main-preload.js",
      "build/settings-preload.js",
      "public/**/*",
      "server/**/*",
      "server/.env.example",
      "!server/.env",
      "!server/cache/**",
      "!server/data/**",
      "!server/riot-api-key.txt",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "github",
      "owner": "snfabirk",
      "repo": "ttp-desktop",
      "releaseType": "release"
    },
    "afterPack": "build/afterPack.js",
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signAndEditExecutable": false
    },
    "nsis": {
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico"
    }
  },
  "allowScripts": {
    "electron@32.3.3": true
  }
}
